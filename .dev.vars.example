# Copy to .dev.vars (gitignored) and fill in your own Stripe TEST-mode keys.
# Get these from https://dashboard.stripe.com/test/apikeys and
# https://dashboard.stripe.com/test/webhooks (or from `stripe listen` when
# testing locally — it prints a whsec_... for that session).
#
# Never put live keys here or in wrangler.jsonc. For deployment, live keys
# are set with `wrangler secret put STRIPE_SECRET_KEY` (and _WEBHOOK_SECRET),
# only after CLAUDE.md §9 is fully closed out.

# Shared admin password. In production: `wrangler secret put ADMIN_PASSWORD`.
ADMIN_PASSWORD=canvia-aixo-en-local
ADMIN_SESSION_SECRET=canvia-aixo-per-una-cadena-aleatoria-de-32-caracters-minim

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Apps Script relay: sheet row + buyer email in one call from the webhook.
# Leave empty and the site works, minus the email and the live sheet.
SHEETS_RELAY_URL=
SHEETS_RELAY_SECRET=

PUBLIC_BASE_URL=http://localhost:3000
CHECKOUT_ENABLED=true
TERMS_VERSION=2026-09-10
MAINTENANCE_SECRET=

# Minimum public identity shown by this temporary promotion site.
# Both values are required before checkout can run outside localhost.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=promocio14medicinaudg@gmail.com
